# systemd USER unit (no root): ~/.config/systemd/user/mie-fuzz.service
[Unit]
Description=Dexmond MIE nightly fuzzing (one hour per target, sanitizers on)

[Service]
Type=oneshot
# Adjust the path to where the script is kept on the node (a copy outside the fuzzing clone).
ExecStart=%h/mie-fuzz/run_nightly.sh
Environment=MIE_FUZZ_WORK=/mnt/node4-work/mie-fuzz
Environment=MIE_FUZZ_SECONDS=3600
Nice=10
# One core per target; today one target. Raise CPUQuota with the number of targets (100% each).
CPUQuota=100%
MemoryMax=6G
TimeoutStartSec=3h
